  "routing": {
    "tiers": ["cheap", "standard", "premium"],
    "thresholds": [0.25, 0.5],
    "defaultPolicy": "routed",
    "budgetDowngradeAt": 0.8,
    "maxModelsPerRequest": 3,
    "latencyMinSamples": 20
  },
  "resilience": {
    "timeoutMs": 15000,
    "maxRetries": 2,
    "backoff": { "baseMs": 200, "maxMs": 2000 },
