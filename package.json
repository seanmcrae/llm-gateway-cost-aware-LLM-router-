{
  "name": "llm-gateway",
  "version": "0.1.0",
  "description": "Cost-aware, OpenAI-compatible LLM gateway: policy routing across model tiers, fallback chains, retries, circuit breakers, response caching, per-tenant budgets and rate limits, and cost/latency telemetry.",
  "license": "MIT",
  "author": "Sean McRae",
  "homepage": "https://seanmcrae.github.io/llm-gateway-cost-aware-LLM-router-/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seanmcrae/llm-gateway-cost-aware-LLM-router-.git"
  },
  "bugs": {
    "url": "https://github.com/seanmcrae/llm-gateway-cost-aware-LLM-router-/issues"
  },
  "keywords": [
    "llm",
    "gateway",
    "router",
    "openai-compatible",
    "anthropic",
    "cost-optimization",
    "circuit-breaker",
    "rate-limiting",
    "semantic-cache",
    "observability"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "llm-gateway": "dist/bin/server.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin/server.js",
    "dev": "tsx src/bin/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx scripts/demo.ts",
    "bench": "tsx bench/run.ts",
    "bench:generate": "tsx bench/generate.ts",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "chart": "tsx scripts/site/chart.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "marked": "^18.1.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
