{
  "name": "llm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI-compatible LLM gateway with policy routing, circuit breakers, exact and semantic caching, per-tenant rate limits and budgets, PII redaction, a SQLite usage ledger and Prometheus metrics.",
  "license": "MIT",
  "author": "Sean McRae",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "llm-gateway": "dist/bin/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/bin/server.js",
    "dev": "tsx src/bin/server.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "better-sqlite3": "^12.11.1",
    "hono": "^4.13.13",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.7"
  }
}
